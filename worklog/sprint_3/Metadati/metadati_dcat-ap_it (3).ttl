#    #Standard di conformità (la nostra ontologia)

<http://www.progetto-shell.org/resource/Standard/ontologia-dati-cultura>
    a dcatapit:Standard, dct:Standard ;
    dct:identifier "http://www.progetto-shell.org/dati-cultura-ontology" ;
    dct:title "Ontologia opere d'arte - progetto dati.cultura (SHELL)"@it ;
    dct:description "Ontologia OWL che definisce le classi e le proprietà a cui il dataset è conforme (Artwork, Painting, CulturalInstituteOrSite, Place, TimeReference e sottoclassi)."@it .
