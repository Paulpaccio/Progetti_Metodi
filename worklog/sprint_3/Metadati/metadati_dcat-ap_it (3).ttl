#    Catalogo

<http://www.progetto-shell.org/resource/Catalogo/dati-cultura-shell>
    a dcatapit:Catalog, dcat:Catalog ;
    dct:title "Catalogo dati.cultura - Progetto SHELL"@it ;
    dct:description "Catalogo dei dati aperti prodotti nell'ambito del sotto-progetto dati.cultura del progetto SHELL, relativi alle opere d'arte conservate in istituti e luoghi della cultura italiani."@it ;
    dct:publisher <http://www.progetto-shell.org/resource/Amministrazione/m_bac> ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:issued "2026-08-25"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
    dcat:themeTaxonomy <http://publications.europa.eu/resource/authority/data-theme> ;
    dcat:dataset <http://www.progetto-shell.org/resource/Dataset/opere-arte-m_bac> .


#    Dataset

<http://www.progetto-shell.org/resource/Dataset/opere-arte-m_bac>
    a dcatapit:Dataset, dcat:Dataset ;
    dct:identifier "m_bac:D.1" ;
    dct:title "Opere d'arte conservate in istituti e luoghi della cultura"@it ;
    dct:description "Dataset delle opere d'arte (dipinti) conservate presso istituti e luoghi della cultura italiani, con indicazione dell'istituto ospitante e del luogo geografico di riferimento. Pubblicato in formato CSV e come Linked Open Data (RDF/Turtle) secondo l'ontologia del progetto SHELL."@it ;
    dct:modified "2026-08-25"^^xsd:date ;
    dct:issued "2026-08-25"^^xsd:date ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/EDUC> ;
    dct:rightsHolder <http://www.progetto-shell.org/resource/Amministrazione/m_bac> ;
    dct:publisher <http://www.progetto-shell.org/resource/Amministrazione/m_bac> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/UNKNOWN> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ITA> ;
    owl:versionInfo "1.0" ;
    dcat:keyword "dipinti"@it , "beni culturali"@it , "patrimonio culturale"@it , "linked open data"@it ;
    dcat:contactPoint <http://www.progetto-shell.org/resource/PuntoContatto/dati-cultura-shell> ;
    dct:subject <http://eurovoc.europa.eu/2122> ; 
    dct:conformsTo <http://www.progetto-shell.org/resource/Standard/ontologia-dati-cultura> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/ITA> ;
    dcat:distribution <http://www.progetto-shell.org/resource/Distribuzione/opere-arte-csv> , <http://www.progetto-shell.org/resource/Distribuzione/opere-arte-ttl> .



#    Distribuzioni

<http://www.progetto-shell.org/resource/Distribuzione/opere-arte-csv>
    a dcatapit:Distribution, dcat:Distribution ;
    dct:title "Opere d'arte - distribuzione CSV"@it ;
    dct:description "Dataset delle opere d'arte in formato tabellare CSV, con codifica UTF-8."@it ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dct:license <https://w3id.org/italia/controlled-vocabulary/licences/A21_CCBY40> ; 
    dcat:accessURL   <http://www.progetto-shell.org/dataset/opere-arte> ;
