<http://www.progetto-shell.org/resource/Distribuzione/opere-arte-ttl>
    a dcatapit:Distribution, dcat:Distribution ;
    dct:title "Opere d'arte - distribuzione RDF/Turtle (Linked Open Data)"@it ;
    dct:description "Dataset delle opere d'arte serializzato come Linked Open Data in RDF/Turtle, conforme all'ontologia del progetto."@it ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
    dct:license <https://w3id.org/italia/controlled-vocabulary/licences/A21_CCBY40> ; 
    dcat:accessURL   <http://www.progetto-shell.org/dataset/opere-arte> ;
    dcat:downloadURL <http://www.progetto-shell.org/dataset/opere-arte/opere_arte.ttl> .



